rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection — OWNER-ONLY.
    //
    // The school/principal (B2B2C) model was removed 2026-05-29 to focus on
    // direct-to-consumer. There is no longer any cross-account read path, which
    // also structurally closes the prior privilege-escalation hole (a student
    // self-setting role:'principal' to read same-school students' PII).
    //
    // If schools/principals return: do NOT grant cross-account reads off a
    // client-writable field like `role`. Gate on a custom auth claim
    // (request.auth.token.role) set server-side, never on users/{uid}.role.
    match /users/{userId} {
      allow read, create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // No self-deletion
    }

    // Progress collection — owner-only.
    match /progress/{userId} {
      allow read, create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;

      // Versioned study plan artifacts
      match /studyPlanArtifacts/{artifactId} {
        allow read, create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if false;
      }

      // Per-attempt snapshot of questions + answers, written from
      // recordPracticeTestResult so Review Answers can render the exact
      // questions the student saw even after content drift.
      match /attempts/{attemptId} {
        allow read, create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if false;
      }

      // AI diagnostic artifacts
      match /aiDiagnostics/{artifactId} {
        allow read, create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if false;
      }

      // AI chat session history.
      //
      // The summarizeChatSession Cloud Function (Admin SDK — bypasses these
      // rules) writes the summary + the cost-control watermarks
      // (lastSummarizedAt, summaryCount). Its trigger re-arms whenever summary
      // is null, so a client that could reset those watermarks and null the
      // summary in a loop would fire unbounded (paid) Haiku summarization calls.
      // Field-pin the update: the client may freshen its own message fields
      // (messages / messageCount / lastMessageAt, etc.) but may NOT touch the
      // watermarks or null out an existing summary. Server writes are unaffected
      // (Admin SDK ignores rules). Create stays open so the client can seed a
      // new session with summary:null.
      match /aiChatSessions/{sessionId} {
        allow read, create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['lastSummarizedAt', 'summaryCount'])
          && !(resource.data.get('summary', null) != null
               && request.resource.data.get('summary', null) == null);
        allow delete: if false;
      }
    }

    // Entitlements (SEVA Premium billing) — SERVER-WRITE-ONLY.
    //
    // The doc holds the trial clock and subscription state. If clients could
    // write it, a student could grant themselves premium (or extend their
    // trial) from devtools. Only Cloud Functions write here (Admin SDK
    // bypasses rules): ensureEntitlement stamps the trial, stripeWebhook
    // applies subscription state. The client only reads (useEntitlement).
    match /entitlements/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }

    // Promo codes — FULLY server-side. The redeemPromoCode function (Admin SDK,
    // bypasses rules) validates the code and grants comped access. Clients must
    // never read (would leak/enumerate codes) or write (would self-grant free
    // access) these. Includes the redeemers/{uid} slot-tracking subcollection.
    match /promoCodes/{code} {
      allow read, write: if false;
      match /redeemers/{userId} {
        allow read, write: if false;
      }
    }
  }
}
