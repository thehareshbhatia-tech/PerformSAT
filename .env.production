# Production build environment (Create React App reads this at build time).
#
# Disable public JS source maps so the full app source is no longer served at
# https://www.sevaprep.com/static/js/main.*.js.map. CRA honors GENERATE_SOURCEMAP.
#
# NOTE: when Sentry goes live, do NOT simply re-enable this. Instead generate
# source maps during the CI build and upload them privately to Sentry (e.g. via
# @sentry/cli / the Sentry webpack/CRA plugin), then delete the .map files from
# the deployed bundle — that keeps readable stack traces in Sentry without
# exposing source to the public.
GENERATE_SOURCEMAP=false
