# Cloud Functions deploy-time params (firebase-functions defineString).
# Copy to functions/.env (gitignored) before `firebase deploy --only functions`.
#
# SECRETS are NOT set here — set them once via:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# (sk_test_/whsec_ values from dashboard.stripe.com; swap to live keys at launch.
#  ANTHROPIC_API_KEY for the AI tutor is managed the same way.)

# Stripe Price ids for the two SEVA Premium plans (Products > Pricing in the
# Stripe dashboard). Create: Product "SEVA Premium" with an $85/month price and
# a $349/year price (billing period: YEARLY — one $349 charge per year, never a monthly-rate price). Use test-mode price ids until launch.
STRIPE_PRICE_MONTHLY=price_xxx_monthly
STRIPE_PRICE_ANNUAL=price_xxx_annual

# The paywall launch moment (ISO). Pre-existing accounts get
# trialEndsAt = max(accountCreatedAt, THIS) + 7 days — set it to the real
# launch date/time right before flipping REACT_APP_FF_BILLING on in Vercel.
BILLING_LAUNCH_EPOCH=2026-07-01T00:00:00Z

# Where Checkout/Portal send the browser back to.
BILLING_APP_BASE_URL=https://www.sevaprep.com
