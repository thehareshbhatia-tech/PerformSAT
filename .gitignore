# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# graphify knowledge-graph output (regenerable; ~6MB — never deploy)
graphify-out/

# Claude Code local/personal settings (machine-specific; not shared)
.claude/settings.local.json

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase
.firebase
.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log

# Test/debug scripts with credentials
test-*.js
check-*.js
*-test.js
# Firebase service account key (NEVER commit)
scripts/serviceAccountKey.json

# Pipeline artifacts: CB-derived extracts (pdf-text/, cbEducatorQBank*, official*)
# must NEVER be committed; reproducible intermediates stay ignored too.
scripts/generated/*
# Own-authored R&W source of truth + registries — NOT reproducible, committed on purpose
!scripts/generated/authored/
!scripts/generated/rwSources/
!scripts/generated/manifests/
scripts/.last-content-tab-generation-report.json
.gstack/

# Playwright E2E
/test-results/
/playwright-report/
/playwright/.cache/

# Auditing pipeline regenerable output
scripts/audit-output/
.vercel

# Source-book PDFs (copyrighted — local reference only, never commit)
knowledge/books/

# Copyrighted reference PDFs (dev-only source material — never commit, esp. public repo)
reference/
/*.pdf

# Creator roster: personal emails + private deal terms (repo is public)
marketing/creators/creators.json
marketing/creators/payout-report*.json
