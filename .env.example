# PerformSAT environment variables — example/template.
# Copy to .env.local and fill in your Firebase project credentials.
# (.env.local is gitignored; .env.example is committed.)

# ─── Firebase ──────────────────────────────────────────────────────────────
# From Firebase Console > Project Settings > Your apps > SDK setup and configuration.
REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# ─── Web Push (re-engagement nudges, Phase 3) ──────────────────────────────
# Generate the key pair at:
#   Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# Paste the PUBLIC key here. Without it the push opt-in card hides itself and no
# FCM token can be minted (the scheduled sendReEngagementNudges function then has
# nobody to send to). The matching service worker is public/firebase-messaging-sw.js.
REACT_APP_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key

# ─── Feature flags ─────────────────────────────────────────────────────────
# Read via `useFeatureFlag('camelCaseKey')` from src/hooks/useFeatureFlag.js.
# Build-time defaults (set per environment); a localStorage runtime override
# per browser session is also available via `localStorage.setItem('ff:<key>','1')`.
#
# todaysTasks  — Day-4 Today's Tasks hero card on the Dashboard tab.
#                The card replaces the legacy AI Practice Banner when a study
#                plan exists. Set to `true` to gate-on the new dashboard layout.
REACT_APP_FF_TODAYS_TASKS=false
#
# rwDrills     — Day-1-2 R&W focus area drills via the section-tagged
#                weakness contract + R&W bank dispatcher. When `false`, only
#                math weaknesses route to a working drill; R&W weaknesses
#                show a "coming soon" placeholder.
REACT_APP_FF_RW_DRILLS=false
#
# pushNudges   — Phase 3 web-push re-engagement opt-in card on the dashboard.
#                Requires REACT_APP_FIREBASE_VAPID_KEY. The card self-hides when
#                push is unsupported (e.g. iOS Safari outside an installed PWA),
#                already granted/denied, or dismissed.
REACT_APP_FF_PUSH_NUDGES=false
